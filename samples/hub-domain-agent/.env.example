# Existing project and text-model deployment; no resources/models are provisioned.
PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
MODEL_DEPLOYMENT=gpt-5.4-mini
# Build/push the image first, then use an immutable linux/amd64 runtime digest.
AGENT_IMAGE=YOUR-REGISTRY.azurecr.io/hub-domain-agent@sha256:REPLACE-WITH-64-HEX-DIGEST
AGENT_PREFIX=hub-domain-demo
IDLE_TIMEOUT_SECONDS=120
DOMAIN_MODEL_WARMUP=true
# Same resource as PROJECT_ENDPOINT, unless explicitly configured otherwise.
VOICE_LIVE_ENDPOINT=wss://YOUR-ACCOUNT.services.ai.azure.com/voice-live/realtime
VOICE_LIVE_API_VERSION=2026-07-15
VOICE_NAME=en-US-JennyNeural
# Optional, used only by generate_audio.py (Azure Speech TTS).
SPEECH_ENDPOINT=https://YOUR-SPEECH-ACCOUNT.cognitiveservices.azure.com
